<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ApexFlow - Fictional Startup</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- 1. HEADER SECTION -->
  <header class="navbar">
    <div class="logo">ApexFlow</div>
    <nav>
      <ul class="nav-links">
        <li><a href="#features">Features</a></li>
        <li><a href="#testimonials">Testimonials</a></li>
        <li><a href="#pricing">Pricing</a></li>
      </ul>
    </nav>
  </header>

  <!-- HERO BANNER -->
  <section class="hero">
    <h1>Work at the Speed of Thought</h1>
    <p>The automated command center for modern remote engineering teams.</p>
    <a href="#" class="btn-primary">Get Started Free</a>
  </section>

  <!-- 2. FEATURE HIGHLIGHTS SECTION (Using CSS Grid) -->
  <section id="features" class="features-section">
    <h2 class="section-title">Engineered for Performance</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Instant Pipeline</h3>
        <p>Deploy production-ready features globally in less than 30 seconds with automatic configuration.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🛡️</div>
        <h3>Zero-Trust Security</h3>
        <p>Identity protection and end-to-end data encryption embedded directly inside your development cycle.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h3>Real-time Metrics</h3>
        <p>Track team velocity, error tracking, and bandwidth bottlenecks directly from your main dashboard.</p>
      </div>
    </div>
  </section>

  <!-- 3. TESTIMONIALS SECTION (Using Flexbox) -->
  <section id="testimonials" class="testimonials-section">
    <h2 class="section-title">Trusted by Tech Leaders</h2>
    <div class="testimonials-container">
      <div class="testimonial-card">
        <p class="quote">"ApexFlow completely reshaped how our engineering department coordinates. Deployment blockages dropped to zero within our first week."</p>
        <div class="user-info">
          <strong>Sarah Jenkins</strong>
          <span>CTO, InnovateLabs</span>
        </div>
      </div>
      <div class="testimonial-card">
        <p class="quote">"The automated pipeline metrics saved us countless hours of manual diagnostics. It's an indispensable asset for remote engineering."</p>
        <div class="user-info">
          <strong>Marcus Chen</strong>
          <span>VP of Engineering, CloudScale</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FOOTER SECTION -->
  <footer>
    <div class="footer-content">
      <p>&copy; 2026 ApexFlow Inc. All rights reserved. Fully responsive concept built with HTML5 & CSS3.</p>
    </div>
  </footer>

</body>
</html>
